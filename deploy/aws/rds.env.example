# Example only, do not commit real credentials. Set the real value as a secret.
# URL-encode the username/password. Supply the RDS CA bundle in the container.
DATABASE_URL=postgresql+psycopg://DB_USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/sundaevale?sslmode=verify-full&sslrootcert=/app/certs/rds-ca-bundle.pem
INVOICE_STORAGE_BACKEND=s3
INVOICE_S3_BUCKET=PRIVATE_BUCKET_NAME
INVOICE_S3_PREFIX=invoices/originals
